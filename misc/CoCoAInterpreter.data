Define Combine(L,K)
  If L=[] Then Return K; EndIf;
  If K=[] Then Return L; EndIf;
  HL:=first(L);
  HK:=first(K);
  If HL[2]=HK[2] Then
    Return concat([[HL[1]*HK[1],HL[2]]],$.Combine(tail(L),tail(K)));
  Else
     If HL[2]>HK[2] Then
        Return concat([HK],$.Combine(L,tail(K)));
     Else
        Return concat([HL],$.Combine(tail(L),K));
     EndIf;
  EndIf;
EndDefine;

