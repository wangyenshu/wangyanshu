TEST_ASSERT(ArrDerModule(A),matrix( /*RingWithID(21234, "QQ[x,y]")*/ [[y +z, x, (1/3)*y^2 +(1/3)*y*z +(-2/3)*z^2],[x +z, y, (1/3)*y^2 +(1/3)*y*z +(-2/3)*z^2],[x +y, z, x*y +(1/3)*y^2 -x*z +(-2/3)*y*z +(1/3)*z^2]]));
