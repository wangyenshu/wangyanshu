define ExampleTitle(str)
  return "\n------<   Example: " + str + "   >------\n";
enddefine; -- ExampleTitle
  

------[   Auxiliary functions   ]--------

define X(AB)
  -- Computes the component x of the vector AB
  A := AB[1];  B := AB[2];
  return B[1]-A[1];
EndDefine; -- X

define Y(AB)
  -- Computes the component y of the vector AB
  A := AB[1];  B := AB[2];
  return B[2]-A[2];
EndDefine; -- Y


