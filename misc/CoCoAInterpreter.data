  <see>GetCols</see>
  <see>GetRows</see>
  <see>ideal</see>
  <see>matrix</see>
  <see>ModuleElem</see>
  <see>RingElem</see>
  <see>SubmoduleCols, SubmoduleRows</see>
</seealso>
</command>
