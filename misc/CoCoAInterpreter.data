Define T2TT(Kx, T,TrueInds)
  L:=exponents(T);
  L1:=NewList(NumIndets(Kx), 0);
  Foreach I In [IndetIndex(J) | J In TrueInds] Do
    L1[I]:=L[I];
  EndForeach;
  Return MakeTerm(Kx,L1);
EndDefine;

Define T2FT(Kx, T,TrueInds)
  L:=exponents(T);
  Foreach I In [IndetIndex(J)|J In TrueInds] Do
    L[I]:=0;
  EndForeach;
  Return MakeTerm(Kx, L);
EndDefine;


