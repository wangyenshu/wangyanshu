K := NewZZmod(101);

use TEST_R ::= K[x,y,z,t];
I := ideal(x^5*y-y^2*z-t+2, y^5*x-z*t+1, x*z^3 -y*t^2-2, y^7-2^7);

t0 := CpuTime(); GB := GBasis(I);  TEST_Time();
t0 := CpuTime(); GBh := GBasisByHomog(ideal(gens(I)));  TEST_Time();
TEST_ASSERT(EqSet(GBh, GB), true);

use TEST_R ::= K[x,y,z,t], lex;
I := ideal(x^3*y-y^2*z-2, y^3*x-z*t, x*z^2 -y-2, x^7-4, y^7-2^7);
