// 5.3.9
Use QQ[x,y];
I := ideal(x-1, y)^2;
PD := PrimaryDecomposition(I);
TEST_ASSERT(EqSet(PD, [I]), true);

I := ideal(x,y)^2; // 0-dim & monomial
PD := PrimaryDecomposition(I);
TEST_ASSERT(EqSet(PD, [I]), true);


