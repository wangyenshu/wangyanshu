I := ideal(x^3*y-y^2*z-2, y^4*x-z*t-1, x*z^2 -y-2, y^7-2^7);
t0 := CpuTime(); GB := GBasis(I);  TEST_Time();
t0 := CpuTime(); GBh := GBasisByHomog(ideal(gens(I)));  TEST_Time();
