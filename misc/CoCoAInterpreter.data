-- /*
-- Return True if T is a SQFR term, False otherwise
-- Example
-- Use R ::= QQ[x,y,z];
-- IsSQFRTerm(x^2);
-- FALSE
-- IsSQFRTerm(xy);
-- TRUE
-- */
Define IsSQFRTerm(T)
  L := Log(T);
  For I:=1 To NumIndets() Do
    If not(L[I] IsIn [0,1]) Then  Return False;  EndIf;
  EndFor;
  Return True;
EndDefine;



