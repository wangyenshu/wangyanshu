Define IsRadical(I)
  if AreGensMonomial(I) then
    return IsRadical_tmp(I);
  endif;  
  if not(IsZeroDim(I)) then
    return I = radical(I); // is there anything better?
  endif;
  return IsRadical_tmp(I);
EndDefine; -- IsRadical

