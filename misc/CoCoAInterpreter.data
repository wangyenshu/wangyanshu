--       Q := $.PDiv(S.M[I,C], S.M[I,I]);
--       $.SommaColonne(ref S, [I,C], -Q);
--       $.MinInII(ref S, I);
--     EndWhile;
--   EndFor;
--   -- lavora sulla i-ma colonna
--   For R := I+1 To NumRows(S.M) Do
--     PrintLn "RecMakeDiag R=" , R, "(",I, ")" ;
