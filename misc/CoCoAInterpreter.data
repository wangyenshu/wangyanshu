<!-- ===  COMMAND  ========================================== -->
<command>
  <title>ArrRestriction</title>
  <short_description>arrangement of hyperplanes A restricted to a hyperplane</short_description>
<syntax>
ArrRestriction(A: <type>LIST</type>, H: <type>RINGELEM</type>): <rtn>LIST</rtn>
</syntax>
<description>
This function returns the list of hyperplanes in the variables
[y[1],..,y[n]] obtained by restricting to the hyperplane H of the list A of hyperplanes of an arrangement.
<example>
/**/ use QQ[x,y,z];	
/**/ A := [x, x-z, y-z, z];
/**/ ArrRestriction(A, y-z);
[y[1],  y[1] -y[2],  y[2]]
</example>
</description>
<seealso>
  <see>MultiArrRestrictionZiegler</see>
</seealso>
<keys>
  <key>author: palezzato, torielli</key>
</keys>
</command>
