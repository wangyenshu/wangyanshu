<!-- ===  COMMAND-rm Poly =============================================== -->
<!-- ===  COMMAND  =============================================== -->
<command>
  <title>PolyAlgebraHom</title>
  <short_description>homomorphism of polynomial algebras</short_description>
<syntax>
PolyAlgebraHom(Domain: <type>RING</type>, Codomain: <type>RING</type>, images: <type>LIST</type>): <rtn>RINGHOM</rtn>
PolyAlgebraHom(Domain: <type>RING</type>, Codomain: <type>RING</type>, images: <type>STRING</type>): <rtn>RINGHOM</rtn>
</syntax>
<description>
These functions create the homomorphism of (polynomial) algebras from
<tt>R</tt> to <tt>S</tt> with the same ring of coefficients.  This is
uniquely defined by the images of the indeterminates of <tt>R</tt> which
are specified by the entries of <tt>images</tt>.  If the rings of coefficients
are not the same, consider using <ttref>PolyRingHom</ttref>.
<par/>
This is a cleaner mathematical implementation of the function
<ttref>image [OBSOLESCENT]</ttref> in CoCoA-4.
<example>
/**/  use R ::= QQ[x,y,z];
/**/  S ::= QQ[x[1..3]];
/**/  phi := PolyAlgebraHom(R, S, indets(S));
/**/  phi(x^2-y);
x[1]^2 -x[2]

/**/  S ::= QQ[a];
/**/  phi := PolyAlgebraHom(R, S, "a,1,0");
/**/  phi(x^2-y);
a^2 -1

/**/  phi := PolyAlgebraHom(R, QQ, "2,1,0"); --> evaluate at [2,1,0]
/**/  phi(x^2-y);
3
</example>
</description>
<seealso>
  <see>Introduction to RINGHOM</see>
  <see>CanonicalHom</see>
  <see>PolyRingHom</see>
</seealso>
<keys>
  <key>map</key>
  <key>homomorphism</key>
</keys>
</command>
<!-- ===  COMMAND  =============================================== -->
<command>
  <title>PolyRingHom</title>
  <short_description>homomorphism of polynomial rings</short_description>
<syntax>
PolyRingHom(R: <type>RING</type>, S: <type>RING</type>, CoeffHom: <type>RINGHOM</type>, images: <type>LIST</type>): <rtn>RINGHOM</rtn>
PolyRingHom(R: <type>RING</type>, S: <type>RING</type>, CoeffHom: <type>RINGHOM</type>, images: <type>STRING</type>): <rtn>RINGHOM</rtn>
</syntax>
<description>
These functions create the homomorphism of (polynomial) algebras between
<tt>R</tt> and <tt>S</tt>.  The homomorphism is uniquely defined by the images
of the indeterminates of <tt>R</tt> and the homomorphism mapping <tt>CoeffRing(R)</tt> into <tt>S</tt>.
If <tt>CoeffHom</tt> is trivial, consider using <ttref>PolyAlgebraHom</ttref> instead.
<example>
/**/ R ::= QQ[x,y];
/**/ S ::= QQ[a,b,c];
/**/ SmodJ := NewQuotientRing(S, "a^2-1");

/**/ phi := PolyRingHom(R, SmodJ, CanonicalHom(QQ,SmodJ), "a,b");
/**/ use R;
/**/ phi(x); --> round brackets in output indicate class in SmodJ
(a)
</example>
</description>
<seealso>
  <see>Introduction to RINGHOM</see>
  <see>CanonicalHom</see>
  <see>PolyAlgebraHom</see>
</seealso>
<keys>
  <key>map</key>
  <key>homomorphism</key>
</keys>
</command>
<!-- ===  COMMAND  ========================================== -->
<command>
  <title>PosetCharPoly</title>
  <short_description>characteristic polynomial of a poset from the relations of the poset</short_description>
<syntax>
PosetCharPoly(relP: <type>LIST</type>): <rtn>RINGELEM</rtn>
</syntax>
<description>
This function returns the characteristic polynomial (in the variable <tt>t</tt>) from
the list <tt>relP</tt> of the strict relations in a graded poset.
<example>
// POSET:
//         3   4
//          \ /
//           2
//           |
//           1
/**/ relP := [[1,  2], [2, 3],  [2,  4]];
/**/ PosetCharPoly(relP);
t^2 -t
</example>
</description>
<seealso>
  <see>PosetPoincarePoly</see>
  <see>ArrCharPoly</see>
</seealso>
<keys>
  <key>author: palezzato, torielli</key>
</keys>
</command>
<!-- ===  COMMAND  ========================================== -->
<command>
  <title>PosetDual</title>
  <short_description>dual of a poset from the relations of the poset</short_description>
<syntax>
PosetDual(relP: <type>LIST</type>): <rtn>LIST</rtn>
</syntax>
<description>
This function returns the dual from the list <tt>relP</tt> of the strict relations in a poset.
<example>
// POSET:
//         3   4
//          \ /
//           2
//           |
//           1
/**/ relP := [[1,  2], [2, 3],  [2,  4]];
/**/ PosetDual(relP);
[[2,  1],  [3,  2],  [4,  2]]
</example>
</description>
<seealso>
  <see>PosetJoin</see>
  <see>PosetMeet</see>
</seealso>
<keys>
  <key>author: palezzato, torielli</key>
</keys>
</command>
<!-- ===  COMMAND  ========================================== -->
<command>
  <title>PosetJoin</title>
  <short_description>join between two elements of a poset from the relations of the poset</short_description>
<syntax>
PosetJoin(relP: <type>LIST</type>, N: <type>INT</type>,  M: <type>INT</type>): <rtn>LIST</rtn>
</syntax>
<description>
This function returns the join (<ie/> the least upper bound)
between the two elements <tt>N</tt>, <tt>M</tt> in the poset <tt>P</tt>
from the list <tt>relP</tt> of its strict relations.
<example>
// POSET:
//         3   4
//          \ /
//           2
//           |
//           1
/**/ relP := [[1,  2], [2, 3],  [2,  4]];
/**/ PosetJoin(relP, 3, 4);
[] --> if it does not exist!

/**/ PosetJoin(relP, 2, 4);
[4]
</example>
</description>
<seealso>
  <see>PosetDual</see>
  <see>PosetMeet</see>
</seealso>
<keys>
  <key>author: palezzato, torielli</key>
</keys>
</command>
<!-- ===  COMMAND  ========================================== -->
<command>
  <title>PosetMeet</title>
  <short_description>meet between two elements of a poset from the relations of the poset</short_description>
<syntax>
PosetMeet(relP: <type>LIST</type>, N: <type>INT</type>,  M: <type>INT</type>): <rtn>LIST</rtn>
</syntax>
<description>
This function returns the meet (<ie/> the greatest lower bound)
between the two elements <tt>N</tt>, <tt>M</tt> in the poset <tt>P</tt>
from the list <tt>relP</tt> of its strict relations.
<example>
// POSET:
//         3   4
//          \ /  \
//           2    5
//           |
//           1
/**/ relP := [[1,  2], [2, 3],  [2,  4], [5,4]];
/**/ PosetMeet(relP, 3, 4);
[2]

/**/ PosetMeet(relP, 2, 5);
[] --> if it does not exist!
</example>
</description>
<seealso>
  <see>PosetDual</see>
  <see>PosetJoin</see>
</seealso>
<keys>
  <key>author: palezzato, torielli</key>
</keys>
</command>
