<!-- ===  COMMAND  =============================================== -->
<command>
  <title>factorial</title>
  <short_description>factorial function</short_description>
<syntax>
factorial(N: <type>INT</type>): <rtn>INT</rtn>
    </syntax>
<description>
This function returns the factorial of <tt>N</tt>, the product
of all integers up to and including <tt>N</tt>.
<example>
/**/  factorial(5);
120

/**/  factorial(25);
15511210043330985984000000
</example>
</description>
<seealso>
  <see>binomial</see>
  <see>primorial</see>
</seealso>
<keys>
  <key>factorial</key>
</keys>
