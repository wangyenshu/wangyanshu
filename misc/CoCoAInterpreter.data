-- Auxiliary (see Coefficients)

Define CoeffList(F,X)
  DegFx := deg(F,X);
  CL := NewList(DegFx + 1);
  For I := 1 To len(CL) Do
    C := NR(F,[X^I]);
    CL[DegFx-I+2] := C/X^(I-1);
    F := F - C;
  EndFor;
  Return CL;
EndDefine; -- CoeffList


