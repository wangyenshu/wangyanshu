Define max(...)
  If len(ARGV) <> 1 Then Return max(ARGV); EndIf;
  L := ARGV[1];
  If len(L)=0 Then error("max: empty list"); EndIf;
  M := L[1];
  Foreach X In L Do
    If X > M Then M := X; EndIf;
  EndForeach;
  Return M;
EndDefine; -- Max

-------------------------------

Define min(...)
  If len(ARGV) <> 1 Then Return min(ARGV); EndIf;
  L := ARGV[1];
  If len(L)=0 Then error("Min: empty list"); EndIf;
  M := L[1];
  Foreach X In L Do
    If X < M Then M := X; EndIf;
  EndForeach;
  Return M;
EndDefine; -- Min

