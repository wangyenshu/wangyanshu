Define Print_Quotient(M)
  X := untagged(M);
  If type(X) = IDEAL Then
    Print RingEnv(X), "/", X;
  Elif type(X) = MODULE Then
    Print RingEnv(X), "^", NumComps(X), "/", X;
  Else Print X;
  EndIf;
EndDefine;

