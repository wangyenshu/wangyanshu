<command>
  <title>SmallestNonDivisor</title>
  <short_description>find smallest prime which does not divide an integer</short_description>
<syntax>
SmallestNonDivisor(N: <type>INT</type>): <rtn>INT</rtn>
</syntax>
<description>
This function finds the smallest prime which does not divide an integer.
It simply tries dividing by all primes in increasing order until it finds
one which does not divide <tt>N</tt>.
<example>
/**/  SmallestNonDivisor(factorial(100));
101

/**/  SmallestNonDivisor(-100);
3
</example>
</description>
<seealso>
  <see>IsPrime</see>
  <see>IsProbPrime</see>
  <see>FactorINT</see>
</seealso>
<keys>
  <key>factor</key>
  <key>factorization</key>
  <key>small prime</key>
  <key>smallest prime</key>
</keys>
</command>
