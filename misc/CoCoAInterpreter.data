-- redmine 1409 -- found by Ashkan Nikseresht

K::=ZZ/(2);
Use S::=K[a,b,x,y];
J:=ideal(a^2+a+1, b^2 +(a)*b +(1), (x-a)^2,(y-b^2));
Iz:=Elim([a,b],J);
Use R::=K[x,y];
phi:=PolyAlgebraHom(S,R,[0,0,x,y]);
if not(IsPrimary(ideal(phi(gens(Iz))))) then print "Error: IsPrimary (redmine 1409)"; endif;

