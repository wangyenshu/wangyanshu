<!-- ===  COMMAND  =============================================== -->
<command>
  <title>RandomSparseNonSing01Mat</title>
  <short_description>random sparse non-singular (0,1) matrix</short_description>
<syntax>
RandomSparseNonSing01Mat(R: <type>RING</type>, N: <type>INT</type>): <rtn>MAT</rtn>
</syntax>
<description>
This function returns a random <tt>N</tt>-by-<tt>N</tt> sparse matrix (with entries
0 or 1) having non-zero determinant.
<example>
/**/ RandomSparseNonSing01Mat(ZZ, 3);
matrix(ZZ,
 [[1, 1, 0],
  [0, 1, 0],
  [0, 0, 1]])
</example>
