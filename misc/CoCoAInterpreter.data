/**/  use R ::= QQ[x,y,z];
/**/  R5 := NewFreeModule(R,5);
/**/  V := ModuleElem(R5, [0,  0,  x^2+y*z,  0,  z^2]);

/**/  FirstNonZero(V);
x^2 +y*z

/**/  FirstNonZeroPosn(V);
3
</example>
</description>
