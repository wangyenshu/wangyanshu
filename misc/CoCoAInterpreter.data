// 2 aux fns for "starting"
define LowerChar(ch) // ASSUME ch is ASCII code!!!
  if ch < 65 or ch > 90 then return ch; endif;
  return ch+32;
enddefine; -- LowerChar

define LowerString(S)
  return ascii([LowerChar(ch) | ch in ascii(S)]);
enddefine; -- LowerString

Define starting(str)
  CaseSensitive := false;
  // NEATER THIS WAY:  (???)
  // IdentityMap := func(S) return S endfunc;
  // if CaseSensitive then map := IdentityMap; else map := LowerString; endif;
  // str := map(str);
  // ...
  // TL := [F In TLF | len(F.name)>=L And map(substring(F.name,1,L)) = str];
  // ...
  // Pkg := [F In TLF | str IsIn map(F.name) And F.IsExported];
  L := len(str);
  if not(CaseSensitive) then str := LowerString(str); endif;
  TLF := TopLevelFunctions();
  if not(CaseSensitive) then 
    TL := [F In TLF | len(F.name)>=L And LowerString(substring(F.name,1,L)) = str];
  else
    TL := [F In TLF | len(F.name)>=L And sum([(F.name)[I] | I In 1..L],"") = str];
  endif;
  str := "."+str;
  if not(CaseSensitive) then 
    Pkg := [F In TLF | str IsIn LowerString(F.name) And F.IsExported];
  else
    Pkg := [F In TLF | str IsIn F.name And F.IsExported];
  endif;
  Return concat(TL, Pkg);
EndDefine; -- starting

