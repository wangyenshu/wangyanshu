<!-- ===  COMMAND  =============================================== -->
<command>
  <title>DicksonPoly</title>
  <short_description>Dickson polynomial</short_description>
<syntax>
DicksonPoly(X: <type>RINGELEM</type>, N: <type>INT</type>, ALPHA: <type>RINGELEM</type>): <rtn>RINGELEM</rtn>
DicksonPoly2(X: <type>RINGELEM</type>, N: <type>INT</type>, ALPHA: <type>RINGELEM</type>): <rtn>RINGELEM</rtn>
</syntax>
<description>
These functions return the Dickson polynomials (of 1st and 2nd type
respectively) of degree <tt>N</tt> in <tt>X</tt> with parameter <tt>ALPHA</tt>.
<example>
/**/  use QQ[x, alpha];
/**/  DicksonPoly(x, 3, alpha);
x^3 -3*x*alpha
</example>
</description>


<keys>
  <key>DicksonPoly2</key>
</keys>
</command>
