<!-- ===  COMMAND  =============================================== -->
<command>
  <title>det</title>
  <short_description>the determinant of a matrix</short_description>
<syntax>
det(M: <type>MAT</type>): <rtn>RINGELEM</rtn>
</syntax>
<description>
This function returns the determinant of the matrix <tt>M</tt>.
<example>
/**/  use R ::= QQ[x];
/**/  M := mat(R,[[x,x^2], [x,x^3]]);
/**/  det(M);
x^4 -x^3

/**/ det(mat(QQ,[[1,2], [0,5]]));
5
</example>
</description>
<seealso>
  <see>HadamardBoundSq</see>
  <see>minors</see>
</seealso>
