------------------------------------------------------------------------------
-- checks if a graph has an odd hole (not triangle)

-- hasOddHole = method();
-- hasOddHole Graph := G -> (
--      coverI := coverIdeal G;
--      any(ass coverI^2,i->codim i > 3)
--      )

// optimize this!
define HasOddHole(G)
  return AllOddHoles(G) <> [];  
enddefine; -- HasOddHole

