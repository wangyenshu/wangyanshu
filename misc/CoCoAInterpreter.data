<command>
  <title>tag</title>
  <short_description>returns the tag string of an object</short_description>
<syntax>
tag(E: <type>OBJECT</type>): <rtn>STRING</rtn>
</syntax>
<description>
If E is a tagged object, this function returns the tag of E;
otherwise, it returns the empty string.
<example>
/**/  L := tagged(3,"MyTag");
/**/  type(L);
TAGGED("$TopLevel.MyTag")

/**/  tag(L);
MyTag
</example>
</description>
<seealso>
  <see>Printing a Tagged Object</see>
  <see>tagged</see>
  <see>untagged</see>
</seealso>
<types>
  <type>io</type>
  <type>printing</type>
  <type>tags</type>
</types>
</command>
<!-- ===  COMMAND  =============================================== -->
<command>
  <title>tagged</title>
