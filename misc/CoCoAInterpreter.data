<tr><td>&nbsp;</td></tr>

<tr bgcolor=#FFFF80><td colspan=3 align=center><b><font size=5><a name="file">File</a></font></b></td></tr>
<tr bgcolor=#FFFFB0>
	<th>&nbsp;</th>
	<th width=20%>Entry name</th>
	<th>Description</th>
</tr>
<tr bgcolor=#EEEEEE>
	<td><center><a href="toolbars.html#file_new"><img src="images/filenew.png" width=16 height=16></a></center></td>
