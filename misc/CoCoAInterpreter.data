<command>
  <title>ColumnVectors [OBSOLETE]</title>
  <short_description>[OBSOLETE] list of module elements</short_description>
<description>
Essentially replaced by <ttref>GensAsCols, GensAsRows</ttref>
and <ttref>SubmoduleCols, SubmoduleRows</ttref>
</description>
</command>
<!-- ===  COMMAND  =============================================== -->
<command>
  <title>CommonDenom</title>
  <short_description>Common denominator of a polynomial with rational coefficients</short_description>
<syntax>
CommonDenom(f: <type>RINGELEM</type>): <rtn>RINGELEM</rtn>
CommonDenom(L: <type>LIST</type> of RINGELEM): <rtn>RINGELEM</rtn>
</syntax>
<description>
This function returns a common denominator for the polynomial <tt>f</tt>.
The coefficient ring of the polynomial ring to which <tt>f</tt> belongs
must be a fraction field.
<example>
/**/  use P ::= QQ[x,y];
/**/  f := (1/4)*x+(1/6)*y;
/**/ CommonDenom(f);
12
/**/ CommonDenom(2*x);
1
/**/ CommonDenom([2*x, y/3]);
3
</example>
</description>
<seealso>
  <see>ClearDenom</see>
  <see>content</see>
  <see>ContentWRT</see>
  <see>prim</see>
</seealso>
<types>
  <type>polynomial</type>
</types>
<keys>
  <key>denominator</key>
</keys>
</command>
