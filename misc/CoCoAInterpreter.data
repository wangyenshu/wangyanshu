-- Pretty Printing of tagged objects

Define Print_Time(R)
  X := mod(R.Cpu,100);
  If X < 10 Then Dot := ".0"; Else Dot := "."; EndIf;
  PrintLn;
  Print "Cpu time = ", div(R.Cpu, 100), Dot, X;
  Print ", User time = ", R.User;
EndDefine;

