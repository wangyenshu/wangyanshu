    ImportByValue FnName;
    if VerbosityLevel() < l then return false; endif;
// indent 2 spaces (min 3spaces for CoCoALib verbosity)
    print "  [L", l, ",", FnName, "]   ";
    return true;
  endfunc;
enddefine; -- IsVERBOSE_func

  
