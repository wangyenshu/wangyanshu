<!-- ===  COMMAND  ========================================== -->
<command>
  <title>MultiArrDerModule</title>
  <short_description>set of generators of the module of logarithmic derivations of a multiarrangement of hyperplanes</short_description>
<syntax>
MultiArrDerModule(MultiA: <type>LIST</type>): <rtn>MAT</rtn>
</syntax>
<description>
This function returns the matrix whose columns are a set of generators
of the module of logarithmic derivations of a multiarrangement of hyperplanes.
<example>
/**/ use QQ[x,y];	
/**/ MultiA := [[x,1], [x-y,3], [y,2]];
/**/ MultiArrDerModule(MultiA);
matrix( /*RingWithID(2200, "QQ[x,y]")*/
 [[x*y^2, x^3 -3*x^2*y],
  [x*y^2, -3*x*y^2 +y^3]])	
</example>
</description>
<seealso>
  <see>MultiArrExponents</see>
  <see>IsMultiArrFree</see>
</seealso>
</command>
<!-- ===  COMMAND  ========================================== -->
<command>
  <title>MultiArrExponents</title>
  <short_description>exponents of a free multiarrangement of hyperplanes</short_description>
<syntax>
MultiArrExponents(MultiA: <type>LIST</type>): <rtn>LIST</rtn>
</syntax>
<description>
This function returns the list of exponents of a free multiarrangement of hyperplanes MultiA.
<example>
/**/ use QQ[x,y];	
/**/ MultiA := [[x,1], [x-y,3], [y,2]]; -- free
/**/ MultiArrExponents(MultiA);
[3,  3]

/**/ use QQ[x,y,z];
/**/ MultiA := [[x,1], [x-y,3], [z,2], [x+y-z,3]]; -- not free
/**/ IsMultiArrFree(MultiA); --> false
-- /**/ MultiArrExponents(MultiA);  --> !!! ERROR !!! as expected, not free
</example>
</description>
<seealso>
  <see>MultiArrDerModule</see>
  <see>IsMultiArrFree</see>
</seealso>
</command>
<!-- ===  COMMAND  ========================================== -->
<command>
  <title>MultiArrRestrictionZiegler</title>
  <short_description>Ziegler multirestriction of the arrangement of hyperplanes  wrt a hyperplane</short_description>
<syntax>
MultiArrRestrictionZiegler(A: <type>LIST</type>, H: <type>RINGELEM</type>): <rtn>LIST</rtn>
</syntax>
<description>
This function returns the Ziegler multirestriction of the arrangement of
hyperplanes A with respect to its hyperplane H in the variables [y[1],..,y[n]].
<example>
/**/ use QQ[x,y,z];	
/**/ A := [x, x-z, y-z, z];
/**/ MultiArrRestrictionZiegler(A, z);
[[y[1],  2],  [y[2],  1]]
</example>
</description>
<seealso>
  <see>ArrRestriction</see>
  <see>ArrToMultiArr</see>
</seealso>
</command>
