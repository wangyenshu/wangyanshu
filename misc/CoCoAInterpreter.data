-- BIGKER

LinKerBasis(A);  -- indeed A is the matrix of an injective homomorphism
BigKerBasis(A);

C :=  mat([[1, 0, 0],
	   [0, 0, 0],
	   [0, 1, 0]]);
LinKerBasis(C);
C^2;
LinKerBasis(C^2);
C^3;  -- same as C^2, so C^n=C^2 for all n>2
-- so we have....
BigKerBasis(C);

