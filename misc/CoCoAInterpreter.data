Define PutInZ(P)
  N:=1;
  S:=[LC(M) | M In monomials(P)];
  Foreach C In S Do
    If type(C)=RAT Then N:=LCM(N,C.Den); EndIf
  EndForeach;
  Return N*P;
EndDefine;

