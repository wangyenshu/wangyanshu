//           2
//           |
//           1
/**/ relP := [[1,  2], [2, 3],  [2,  4]];
/**/ PosetNRank(relP, 2);
1
</example>
</description>
<seealso>
  <see>PosetRank</see>
  <see>MaxChains</see>
</seealso>
<keys>
  <key>author: palezzato, torielli</key>
