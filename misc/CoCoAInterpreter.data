Define Intersection(...)
  If len(ARGV)=2 Then Return intersection(ARGV[1], ARGV[2]); EndIf;
  PrintLn "--> WARNING: Intersection(A,B,C) is obsolescent (from CoCoA-5.1.5); use IntersectionList([A,B,C]) instead";
  Return IntersectionList(ARGV);
EndDefine;

