<!-- ===  COMMAND  =============================================== -->
<command>
  <title>dim</title>
  <short_description>the dimension of a (quotient) ring</short_description>
<syntax>
dim(R: <type>RING</type>): <rtn>INT</rtn>
</syntax>
<description>
This function computes the dimension of the ring <tt>R</tt>, where <tt>R</tt> is a
quotient of a polynomial ring.  NB: the coefficient ring must be a field.
<par/>
If <tt>I</tt> is a zero-dimensional ideal in the polynomial ring <tt>P</tt>, and
you want the compute the vector-space dimension of <tt>P/I</tt> then use the
function <ttref>multiplicity</ttref>.
<example>
/**/  use R ::= QQ[x,y,z];
/**/  dim(R/ideal(x));
2

/**/  dim(R/ideal(y^2-x, x*z-y^3));
1
</example>
</description>
<types>
  <type>groebner</type>
</types>
<seealso>
  <see>multiplicity</see>
</seealso>

<keys>
  <key>dimension</key>
  <key>author: anna maria bigatti</key>
</keys>
</command>
<!-- ===  COMMAND  =============================================== -->
<command>
  <title>discriminant</title>
  <short_description>the discriminant of a polynomial</short_description>
<syntax>
discriminant(F: <type>RINGELEM</type>): <rtn>RINGELEM</rtn>
discriminant(F: <type>RINGELEM</type>, X: <type>RINGELEM</type>): <rtn>RINGELEM</rtn>
</syntax>
<description>
These functions compute the discriminant of a non-constant polynomial ``F``
with respect to the indeterminate ``X``; in the first form ``F`` must be
univariate, and ``X`` is taken to be its indeterminate.
<par/>
The discriminant is defined as
<verbatim>
(-1)^(N*(N-1)/2)*det(M)/M[1,1]
</verbatim>
where <tt>M := SylvesterMat(F, deriv(F,X), X)</tt>
and  <tt>N := deg(F, X)</tt>.
<example>
/**/  Use R ::= QQ[x,y];
/**/  discriminant(x^2+3*y^2, x);
-12*y^2

/**/  discriminant(x^2+3*y^2, y);
-12*x^2

/**/  discriminant((x+1)^20+2);
54975581388800000000000000000000
</example>
</description>
<seealso>
  <see>resultant</see>
</seealso>
</command>
<!-- ===  COMMAND  =============================================== -->
<command>
  <title>distrib</title>
  <short_description>the distribution of objects in a list</short_description>
<syntax>
distrib(L: <type>LIST</type>): <rtn>LIST</rtn>
</syntax>
<description>
For each object <tt>E</tt> of a list <tt>L</tt>,
let N(E) be the number of times <tt>E</tt> occurs as a component of <tt>L</tt>.
Then <tt>distrib(L)</tt> returns the list whose components are <tt>[E, N(E)]</tt>.
<example>
/**/  distrib(["b","a","b",4,4,[1,2]]);
[["b", 2],  ["a", 1],  [4, 2],  [[1, 2], 1]]
</example>
</description>
<seealso>
  <see>count</see>
</seealso>
</command>
<!-- ===  COMMAND  =============================================== -->
<command>
  <title>div</title>
  <short_description>quotient for integers</short_description>
<syntax>
div(N: <type>INT</type>, D: <type>INT</type>): <rtn>INT</rtn>
</syntax>
<description>
This function computes the integer quotient of <tt>N</tt> divided by <tt>D</tt>;
it is equal to <tt>N/D</tt> <em>rounded towards zero</em>.
The companion function <ttref>mod</ttref> computes the corresponding remainder.
<par/>
If we set <tt>Q = div(N,D)</tt> and <tt>R = mod(N,D)</tt> then <formula>N = Q*D + R</formula>.
<par/>
NOTE: for polynomials use <ttref>NR</ttref> (remainder),  <ttref>DivAlg</ttref> (quotients and remainder),
<ttref>IsIn</ttref> (ideal membership).
<example>
/**/ div(10,3);
3
/**/ div(10,-3);
-3
</example>
</description>
<seealso>
  <see>mod</see>
  <see>DivAlg</see>
  <see>IsIn</see>
  <see>NR</see>
  <see>ceil</see>
  <see>floor</see>
</seealso>
</command>
<!-- ===  COMMAND  =============================================== -->
<command>
  <title>DivAlg</title>
  <short_description>division algorithm</short_description>
<syntax>
DivAlg(X: <type>RINGELEM</type>, L: <type>LIST</type> of <type>RINGELEM</type>): <rtn>RECORD</rtn>
DivAlg(X: <type>MODULEELEM</type>, L: <type>LIST</type> of <type>MODULEELEM</type>): <rtn>RECORD</rtn>
</syntax>
<description>
This function performs the division algorithm on X with respect to L.
It returns a record with two fields: <tt>quotients</tt> holding a list of
polynomials, and <tt>remainder</tt> holding the remainder of X upon division
by L.
<example>
/**/  use R ::= QQ[x,y,z];
/**/  F := x^2*y +x*y^2 +y^2;
/**/  L := [x*y-1, y^2-1];
/**/  DivAlg(F, L);
record[quotients := [x +y, 1], remainder := x +y +1]

/**/  D := It;
/**/  D.quotients;
[x +y, 1]
/**/  D.remainder;
x +y + 1
/**/  ScalarProduct(D.quotients, L) + D.remainder = F;
true

/**/  R2 := NewFreeModule(R,2);
/**/  V := ModuleElem(R2, [x^2+y^2+z^2, x*y*z]);
/**/  L := gens(SubmoduleRows(R2, mat([[x,y], [y,z], [z,x]])));
/**/  D := DivAlg(V, L);
/**/  indent(D);
record[
  quotients := [x,  -z^2 +y +z,  y*z -y],
  remainder := [z^2,  z^3 -y*z -z^2]
]
/**/ sum([D.quotients[i]*L[i] | i in 1..len(L)]) + D.remainder;
[x^2 +y^2 +z^2, x*y*z]
</example>
</description>
<seealso>
  <see>div</see>
  <see>mod</see>
  <see>GenRepr</see>
  <see>NF</see>
  <see>NR</see>
</seealso>
<keys>
  <key>remainder</key>
  <key>division algorithm</key>
</keys>
</command>
<!-- ===  COMMAND  =============================================== -->
<command>
  <title>domain</title>
  <short_description>domain of a homomorphism</short_description>
<syntax>
domain(phi: <type>RINGHOM</type>): <rtn>RING</rtn>
</syntax>
<description>
This function returns the domain of the homomorphism <tt>phi</tt>.
<example>
/**/  P := NewPolyRing(RingQQ(), "alpha,beta");
/**/  phi := CanonicalHom(RingZZ(), P);
/**/  domain(phi);
ZZ
/**/  psi := CoeffEmbeddingHom(P);
/**/  domain(psi);
QQ
</example>
</description>
<keys>
  <key>homomorphism</key>
</keys>
<seealso>
  <see>codomain</see>
  <see>Commands and Functions for RINGHOM</see>
  <see>Commands and Functions returning RINGHOM</see>
</seealso>
</command>

</chapter_letter>
<!-- ===  CHAPTER  =============================================== -->
<chapter_letter>
  <title>E</title>

<!-- ===  COMMAND  =============================================== -->
<command>
  <title>E_ [OBSOLETE]</title>
  <short_description>[OBSOLETE] vectors of the canonical basis</short_description>
<description>
[OBSOLETE] replaced by <ttref>CanonicalBasis</ttref> of a FreeModule.
</description>
</command>
<!-- ===  COMMAND  =============================================== -->
<command>
  <title>eigenfactors</title>
  <short_description>eigenfactors of a matrix</short_description>
<syntax>
eigenfactors(M: <type>MAT</type>, X: <type>RINGELEM</type>): <rtn>LIST</rtn> of <rtn>RINGELEM</rtn>
</syntax>
<description>
<tt>M</tt> must be a square matrix, and <tt>X</tt> an indeterminate.
<par/>
This function determines the eigenfactors of <tt>M</tt>, <ie/> the
irreducible factors of <ttref>CharPoly</ttref> of <tt>M</tt> as polynomials in <tt>X</tt>.
<example>
/**/  use R ::= QQ[x];
/**/  M := mat([[0,2,0,0],[1,0,0,0],[0,0,0,2],[0,0,1,1]]);
/**/  eigenfactors(M, x);
[x+1,  x-2,  x^2-2]
</example>
</description>
<keys>
  <key>eigenvalues</key>
  <key>eigenspace</key>
</keys>
<seealso>
  <see>eigenvectors</see>
</seealso>
</command>
<!-- ===  COMMAND  =============================================== -->
<command>
  <title>eigenvectors</title>
  <short_description>eigenvalues and eigenvectors of a matrix</short_description>
<syntax>
eigenvectors(M: <type>MAT</type>, X: <type>RINGELEM</type>): <rtn>LIST</rtn> of <rtn>RECORD</rtn>
</syntax>
<description>
<tt>M</tt> must be a matrix of numbers, and <tt>X</tt> an indeterminate.
<par/>
This function determines the eigenvalues of <tt>M</tt>, and for each eigenvalue
gives a basis of the corresponding eigenspace -- note that the basis is
probably not orthogonal.  For irrational eigenvalues, the minimal
polynomial of the eigenvalue is given (as a polynomial in <tt>X</tt>), along with
the eigenvectors expressed in terms of a root of the minimal polynomial
(represented as <tt>X</tt>).
<example>
/**/  use R ::= QQ[x];
/**/  M := mat([[1,2,3],[4,5,6],[7,8,9]]);
/**/  eigenvectors(M, x);
[record[MinPoly := x, eigenspace := matrix(QQ,
 [[-1],
  [2],
  [-1]])],
record[MinPoly := x^2 -15*x -18,
eigenspace := [[1,  (1/8)*x +1/4,  (1/4)*x -1/2]]]
]

/**/  M := mat([[0,2,0,0],[1,0,0,0],[0,0,0,2],[0,0,1,0]]);
  eigenvectors(M, x); -- two irrational eigenvalues, each with eigenspace of dimension 2
[record[MinPoly := x^2 -2, eigenspace := [[1, (1/2)*x, 0, 0], [0, 0, 1, (1/2)*x]]]]
</example>
</description>
<keys>
  <key>eigenvalues</key>
  <key>eigenspace</key>
  <key>author: john abbott</key>
</keys>
<seealso>
  <see>eigenfactors</see>
</seealso>
</command>
<!-- ===  COMMAND  =============================================== -->
<command>
  <title>ElapsedTime</title>
  <short_description>Counts elapsed time</short_description>
<syntax>
ElapsedTime(): <rtn>RAT</rtn>
</syntax>
<description>
Use the function <ttref>CpuTime</ttref> to measure how long your program took
to compute its result.
<par/>
This function returns a <tt>RAT</tt> whose value is the <em>elapsed</em> time in
seconds since the start of the program.  We recommend using <ttref>DecimalStr</ttref>
to print out the value in a way which is convenient to comprehend.
<example>
/**/ TimeBeforeSleep := ElapsedTime();
/**/ SleepFor(5);
/**/ TimeAfterSleep := ElapsedTime();
/**/ DecimalStr(TimeAfterSleep - TimeBeforeSleep);
5.001
</example>
</description>
<seealso>
  <see>CpuTime</see>
  <see>DecimalStr</see>
</seealso>
<keys>
  <key>elapsed time</key>
  <key>timing</key>
  <key>real time</key>
  <key>wall clock time</key>
</keys>
</command>
<!-- ===  COMMAND  =============================================== -->
<command>
  <title>elim</title>
  <short_description>eliminate variables</short_description>
<syntax>
elim(X: <type>RINGELEM</type>, M: <type>IDEAL</type>): <rtn>IDEAL</rtn>
elim(L: <type>LIST</type>, M: <type>IDEAL</type>): <rtn>IDEAL</rtn>
elim(X: <type>RINGELEM</type>, M: <type>MODULE</type>): <rtn>MODULE</rtn>
elim(L: <type>LIST</type>, M: <type>MODULE</type>): <rtn>MODULE</rtn>
</syntax>
<description>
This function returns the ideal or module obtained by eliminating the
indeterminate <tt>X</tt>, or all indeterminates in <tt>L</tt>, from <tt>M</tt>.  The coefficient
ring must be a field.
<par/>
As an alternative, there is the function <ttref>ElimMat</ttref> for creating elimination
orderings -- this is used inside the function <tt>elim</tt>.
<example>
/**/ use R ::= QQ[t,x,y,z];
/**/ E := elim(t, ideal(t^15+t^6+t-x, t^5-y, t^3-z));
/**/ indent(E);
ideal(
  z^5 -y^3,
  y^4 +y*z^2 -x*y +z^2,
  x*y^3*z +y^2*z^3 +x*z^3 -x^2*z +y^2 +y,
  y^2*z^4 +x^2*y^3 +x*y^2*z^2 +y*z^4 +x^2*z^2 -x^3 +y^2*z +2*y*z +z,
  y^3*z^3 -x*z^3 +y^3 +y^2
)

/**/ use R ::= QQ[t,s,x,y,z,w];
/**/ t..x;
[t, s, x]

/**/ elim(t..x, ideal(t-x^2*z*w, x^2-t, y^2*t-w)); -- Note the use of t..x.
ideal(z*w^2 -w)

/**/ use R ::= QQ[t[1..2], x[1..4]];
/**/ I := ideal(x[1]-t[1]^4, x[2]-t[1]^2*t[2], x[3]-t[1]*t[2]^3, x[4]-t[2]^4);
/**/ elim(indets(R,"t"), I);
ideal(x[2]^4 -x[1]^2*x[4],  x[3]^4 -x[1]*x[4]^3)
</example>
</description>
<seealso>
  <see>Term Orderings</see>
</seealso>
<types>
  <type>groebner</type>
  <type>groebner-basic</type>
</types>

<keys>
  <key>eliminate</key>
  <key>elimination</key>
</keys>
</command>
<!-- ===  COMMAND  =============================================== -->
<command>
  <title>ElimHomogMat</title>
  <short_description>matrix for elimination ordering</short_description>
<syntax>
ElimHomogMat(ElimInd: <type>LIST</type>, W: <type>MAT</type>): <rtn>MAT</rtn>
</syntax>
<description>
This function returns a matrix for a term ordering eliminating the
indeterminates with indices in <tt>ElimInd</tt> for inputs which are
homogeneous wrt the weights in the matrix <tt>W</tt>.
If you are unsure what this means, just use <ttref>ElimMat</ttref> ;-)
<par/>
NOTE: this function used to be called <tt>HomogElimMat</tt> up to version 5.1.4,
and had swapped arguments.
<example>
/**/  ElimHomogMat([2,3], mat([[1,5,2]]));
matrix(ZZ,
 [[1, 5, 2],
  [0, 1, 1],
  [0, 0, -1]])
</example>
</description>
<seealso>
  <see>elim</see>
  <see>ElimMat</see>
  <see>NewPolyRing</see>
</seealso>
<keys>
  <key>homogeneous elimination matrix</key>
</keys>
</command>
<!-- ===  COMMAND  =============================================== -->
<command>
  <title>ElimMat</title>
  <short_description>matrix for elimination ordering</short_description>
<syntax>
ElimMat(ElimInd: <type>LIST</type> of INT, N: <type>INT</type>): <rtn>MAT</rtn>
ElimMat(ElimInd: <type>LIST</type> of INT, W: <type>MAT</type>): <rtn>MAT</rtn>
</syntax>
<description>
This function returns an <tt>NxN</tt> matrix representing a term ordering
for eliminating the indeterminates with indices in <tt>ElimInd</tt>.
<par/>
In the second form, a weight matrix <tt>W</tt> is given; these weights are
placed immediately below the first elimination row.
<par/>
NOTE: This function used to have swapped arguments up to version
5.1.4. (<eg/> <tt>ElimMat(3, [2,3])</tt>)
<example>
/**/  ElimMat([2,3], 3);
matrix(ZZ,
 [[0, 1, 1],
  [1, 1, 1],
  [0, 0, -1]])

/**/  ElimOrd := ElimMat([2,3], mat([[1,5,2]]));  ElimOrd;
matrix(ZZ,
 [[0, 1, 1],
  [1, 5, 2],
  [0, 0, -1]])
/**/ P := NewPolyRing(QQ, "x,y,z", ElimOrd, 0);
</example>
</description>
<seealso>
  <see>elim</see>
  <see>ElimHomogMat</see>
  <see>NewPolyRing</see>
</seealso>
<keys>
  <key>elimination ordering</key>
  <key>blockordering</key>
  <key>block ordering</key>
  <key>elimmatrix</key>
</keys>
</command>
<!-- ===  COMMAND  =============================================== -->
<command>
  <title>EmbeddingHom</title>
  <short_description>returns the embedding homomorphism of a fraction field</short_description>
<syntax>
EmbeddingHom(K: <type>RING</type>): <rtn>RINGHOM</rtn>
</syntax>
<description>
This function returns the embedding homomorphism of the
fraction field <tt>K</tt>.
<example>
/**/  use P ::= QQ[x,y];
/**/  K := NewFractionField(P);
/**/  phi := EmbeddingHom(K);  -- phi: P -> K
/**/  f := 2*x+3*y;
/**/  phi(f);
2*x +3*y
/**/  RingOf(phi(f));
RingWithID(5, "FractionField(RingWithID(4))")
</example>
</description>
<keys>
   <key>homomorphism</key>
</keys>
<seealso>
  <see>CanonicalHom</see>
