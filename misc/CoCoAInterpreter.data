Define PutPolyLInSubring(L,Inds)
  IndsProd := product(Inds);
  Return [f In L | IsCoprime(IndsProd, IndetsProd(f))];
//  Return [f In L | diff(Inds, $.WhichVars(f)) = Inds];
EndDefine; -- PutPolyLInSubring


