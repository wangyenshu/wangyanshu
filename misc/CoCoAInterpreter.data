/**/ C := NmzComputation(Cinput, ["HilbertSeries"]);
/**/ CHQ := C.HilbertQuasiPolynomial;   indent(CHQ);
[
  (8/9)*t^2 +2*t +1,
  (8/9)*t^2 +(14/9)*t +5/9,
  (8/9)*t^2 +(16/9)*t +8/9
]
/**/ EvalQuasiPoly(CHQ,151);
20503
</example>
