<!-- ===  COMMAND  =============================================== -->
<command>
  <title>IsZZ</title>
  <short_description>test whether a ring is the ring of integers</short_description>
<syntax>
IsZZ(R: <type>RING</type>): <rtn>BOOL</rtn>
</syntax>
<description>
This function tests whether a ring is the ring of integers.
<example>
/**/  R ::= QQ[x,y];
/**/  IsZZ(CoeffRing(R));
false
/**/  IsZZ(BaseRing(CoeffRing(R)));
true
</example>
