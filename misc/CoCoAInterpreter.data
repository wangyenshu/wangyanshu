-----------------------------------------------------------------------//5.3.7
Use P::=QQ[x,y,z]; 
f1 := y*z-2*z^2-x-4*z;
f2 := z^3-y+2*z+1;
f3 := x^2-2*x*y+34*y^2-56*x*z+1369*z^2+256*x-794*y-448*z+2091;

I := ideal(f1, f2, f3);
//L := 3*x+2*y-7*z;


-- PD := PrimaryDecompositionCore0(I,L);
