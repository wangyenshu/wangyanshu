proc ncrepDim(ncrep q)
"USAGE:   ncrepDim(q);
  q of type ncrep

RETURN:   dimension of q;
  returns 0 if q represents the zero-function

EXAMPLE:  example ncrepDim;
  shows an example"
{
  int n = ncols(q.mat);
  // Does q represent zero?
  if (n == 1)
  {
    if (q.lvec == 0 or q.rvec == 0)
    {
      n = 0;
    }
  }
  return (n);
}
