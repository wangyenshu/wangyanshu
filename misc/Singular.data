/*         w_overlap = w_overlap[1 .. (l-2)*lV]; */
/*       } */
/*       if (v_overlap == w_overlap && !lpLmDivides(G, v * lpVarAt(w, l - 1))) { */
/*         UG[i,j] = 1; */
