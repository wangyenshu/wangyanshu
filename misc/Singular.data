      print("Expected:\n");
      print(expected);
      print("obtained:\n");
      print(obtained);
      result = 0;
    }
    kill r3;
    kill R3;
  }
  //Test 5: Proper third Weyl algebra
  ring R = 0,(x1,x2,x3,d1,d2,d3),dp;
  matrix C[6][6] = 1,1,1,1,1,1,
