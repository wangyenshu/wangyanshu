proc ncratFromString(string s)
"USAGE:   ncrat f = ncratFromString(s);
  s of type string

RETURN:   read string s into ncrat f

EXAMPLE:  example ncratFromString;
  shows an example"
{
  // Clear tokenstream
  TOKENSTREAM.input = s;
  TOKENSTREAM.position = 1;
  TOKENSTREAM.full = 0;

  ncrat f = expression();
  return (f);
}
