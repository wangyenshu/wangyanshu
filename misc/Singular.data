    kill r3;
    kill R3;
  }
  //Test 4: All possibilities for third Weyl algebra reversed
  kill perms;
  list perms =list(list(list(-1,0,0,0,0,0),
              list(0,-1,0,0,0,0),
              list(0,0,-1,0,0,0)),
             list(list(-1,0,0,0,0,0),
              list(0,0,-1,0,0,0),
              list(0,-1,0,0,0,0)),
             list(list(0,-1,0,0,0,0),
