        }
        setring br;
        if(r==1)  //r odd
        {
         "r odd";
         number s = (coeff(rf,var(1)^2*var(2)^2));
         s = s^(-n1);
         poly P = var(1)^2-s*(coeff(rf,var(1)^(n1))*coeff(rf,var(2)^(n1)))^2;
