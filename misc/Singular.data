  M = setModuleGrading(M,MGrading);
  multigradedcomplex tate;
  (E,tate) = tateResolution(M,low,high);
  setring(E);

  ring Z = cohomologyMatrixFromResolution(tate,low,high);
  setring(Z);
  print(cohomologymat);

  setring(E);
  intvec  c= 0,-3;
  intvec J = 1;
