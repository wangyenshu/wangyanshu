sub T2H_SING_pre_about
{
  return <<EOT;
This document is the user manual for <A HREF="https://www.singular.uni-kl.de/"><I>Singular</I></A> version $value{VERSION}, $value{VERSION_DATE}.
<BR>

For questions and comments about Singular, send email to <A href="mailto:singular\@mathematik.uni-kl.de">singular\@mathematik.uni-kl.de</a>.

<P></P>
This document was generated by <I>$THISPROG</I>
and is best  viewed with a 16 or 18 point screen font.
<P></P>
EOT
}

$T2H_PRE_ABOUT = \&T2H_SING_pre_about;

