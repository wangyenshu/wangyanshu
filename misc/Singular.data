              list(0,-1,0,0,0,0),
              list(-1,0,0,0,0,0)),
             list(list(0,0,-1,0,0,0),
              list(-1,0,0,0,0,0),
              list(0,-1,0,0,0,0)));
  for(i=1;i<=size(perms);i++)
