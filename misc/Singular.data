sagbiSP(I);

*/

////////////////////////////////////////////////////////////////////////////////
static proc sortSagbi(ideal I)
{
    //sorts, makes input monic and removes zeros
    I=simplify(I,2+1);
    int i;
    int n=1;
    poly p;
    while(n)
    {
       n=0;
       for(i=1;i<size(I);i++)
       {
           if(deg(lead(I[i]))>deg(lead(I[i+1])))
           {
                n=1;
                p=I[i];
                I[i]=I[i+1];
               I[i+1]=p;
               break;
            }
       }
    }
   return(I);
}

/*

ring R=0,t,ds;

