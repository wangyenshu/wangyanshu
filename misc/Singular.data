               x(1)*x(2)^2*d(1)*d(2)+x(4)^3*d(1)*d(4)+2*x(1)*x(2)*d(1)
               -x(2)^2*d(2)-2*x(2)+d(1)),
          list(x(1)*d(2)*x(2)^2+x(4)^3*d(4) + 1,d(1),d(1)));
