      }
      }
    }
    def r3 = nc_algebra(C,D);
    setring(r3);
    expected = 1;
    obtained = ncfactor_isQWeyl();
    if (expected !=obtained)
    {
      print("Test 3 for ncfactor_isQWeyl failed. Basering:");
      basering;
      print("Expected:\n");
      print(expected);
      print("obtained:\n");
      print(obtained);
      result = 0;
