    result = 0;
  }
  kill R;
  //Test 2: Non-commutative ring, constant
  ring R = 0,(x,d),dp;
  def r = nc_algebra(1,1);
  setring(r);
  expected = 1;
  obtained = isInCommutativeSubRing(3445);
  if (expected !=obtained)
