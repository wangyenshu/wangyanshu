   def @@RR=nc_algebra(1,D);
   return(@@RR);
}
example
{ "EXAMPLE:"; echo = 2;
   def ncAlgebra = makeUe8();
   ncAlgebra;
   setring ncAlgebra;
   // ...  7752  noncommutative relations
}
