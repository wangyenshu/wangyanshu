sortSagbi(I);

*/

////////////////////////////////////////////////////////////////////////////////
static proc insertOne(poly p, ideal I, int b)
{
   //assume I is sorted, inserts p at the correct place
     int i,j;
     poly q;
     for(i=1;i<=size(I);i++)
     {
              if(deg(lead(p))<deg(lead(I[i])))
              {
                  break;
              }
     }
     if(i==size(I)+1)
     {
        I=I,simplify(p,1);
     }
     else
     {
         for(j=size(I)+1;j>i;j--)
         {
              I[j]=I[j-1];
         }
         I[i]=simplify(p,1);
     }
     if(i<size(I))
     {
           I=interReduceSagbi(I,b);
     }
     return(I);
}

/*

ring R=0,t,ds;

ideal I=t8,t10+t13,t12+t15;

insertOne(t17,I,20);

I=t8,t10+t13,t12+t15,t23-t29;

insertOne(-2t27,I,40);

*/

////////////////////////////////////////////////////////////////////////////////
static proc interReduceSagbi(ideal I, int b)
{
// reduces the elements of the dial against each other
     I=sortSagbi(I);
     ideal J;
     int n=1;
   int i;
     poly h;
     while(n)
     {
          n=0;
          i=1;
          while(i<size(I))
          {
              i++;
              J=I[1..i-1];
              h=sagbiNF(I[i],J,b);
              h=simplify(h,1);
              if(h!=I[i])
              {
                   n=1;
                   I[i]=h;
                   I=sortSagbi(I);
                   break;
              }
           }
      }
      return(I);
}

