////////////////////////////////////////////////////////////////////////////////
static proc sagbiSP(ideal I)
{
//computes the set of Sagbi-s-polys
   if(I==0){ return(I); }
   list L=algDependent(lead(I));

   def S= L[2];
   map phi= S,maxideal(1),I;
   return(simplify(phi(ker),2));
}

/*

ring R=0,t,ds;

