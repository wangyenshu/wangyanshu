                x(1)*d(1) + x(2)*d(2),
                x(1)*d(1) + x(2)*d(2),
                x(1)*d(1) + x(2)*d(2),
                x(1)*d(1) + x(2)*d(2),
                x(1)*d(1) + x(2)*d(2),
                x(1)*d(1) + x(2)*d(2),
                x(1)*d(1) + x(2)*d(2),
                x(1)*d(1) + x(2)*d(2),
                x(1)*d(1) + x(2)*d(2),
                x(1)*d(1) + x(2)*d(2),
                x(1)*d(1) + x(2)*d(2),
                x(1)*d(1) + x(2)*d(2)));
  list obtained = facWeyl(input);
