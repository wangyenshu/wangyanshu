////////////////////////////////////////////////////////////////////////////////
static proc sagbiNF(poly f,ideal I,int b)
{
//computes the Sagbi normal form
   list L=1;
   poly re;
   map psi;
   f=jet(f,b);
   if(f==0){return(f);}
   while(f!=0)
   {
     L= algebra_containment(lead(f),lead(I),1);
     if (L[1]==1)
     {
        def S= L[2];
        psi= S,maxideal(1),I;
        f=jet(f-psi(check),b);
        kill S;
     }
     else
     {
        re=re+lead(f);
        f=f-lead(f);
     }
   }
   return (re);
}

