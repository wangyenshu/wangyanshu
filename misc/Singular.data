    interReduceSagbi(I,20);

*/
////////////////////////////////////////////////////////////////////////////////

static proc correctBound(ideal I, int b)
{
  //computes the conductor c of the semigroup associated to K[I]
  //if b>=c
   list L;
   int i;
   for(i=1;i<=size(I);i++)
   {
       L[i]=I[i];
   }
   list M=WSemigroup(L,b);
   if(b>M[2])
   {b=M[2]+1;}
   return(b);
}

