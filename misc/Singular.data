version="version dummy.lib 1.0.0.0 June_2019 "; // $Id: 9d070578f34e1d7c411374f103c0874360735797 $
category="General purpose";
info="
LIBRARY:  dummy.lib      dummy library for testing purposes
AUTHORS:  S. Gutsche

PROCEDURES:
 dummy(def);           dummy function that returns its argument
